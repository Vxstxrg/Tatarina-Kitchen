# Подключение к PostgreSQL — один из двух вариантов:

# 1) Локальная база PostgreSQL
# DATABASE_URL="postgresql://postgres:1234@localhost:5432/tatarian_kitchen?schema=public"

# 2) Prisma Accelerate (управляемый пул подключений)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# Секрет для подписи JWT-сессий next-auth.
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="your-auth-secret"
